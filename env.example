# ============================================================
# AtmoSync Environment Configuration
# ============================================================
# Copy this file to .env and replace the placeholder values.
#
# IMPORTANT:
# Never commit your real .env file, passwords, private keys,
# API keys, or other credentials to GitHub.
# ============================================================

# -------------------------
# Snowflake Configuration
# -------------------------

ATMOSYNC_SNOWFLAKE_ACCOUNT=your_account_identifier
ATMOSYNC_SNOWFLAKE_USER=your_username
ATMOSYNC_SNOWFLAKE_PASSWORD=your_password
ATMOSYNC_SNOWFLAKE_ROLE=SYSADMIN
ATMOSYNC_SNOWFLAKE_DATABASE=ATMOSYNC
ATMOSYNC_SNOWFLAKE_WAREHOUSE=your_warehouse

# Snowflake schema used by dbt
ATMOSYNC_SNOWFLAKE_SCHEMA=DEV


# -------------------------
# Kafka Configuration
# -------------------------

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=atmosync-telemetry


# -------------------------
# Application Configuration
# -------------------------

ATMOSYNC_ENVIRONMENT=development
ATMOSYNC_LOG_LEVEL=INFO


# -------------------------
# Dashboard Configuration
# -------------------------

DASHBOARD_TITLE=AtmoSync Micro-Climate Analytics
DASHBOARD_PORT=8501

.env
.env.*
!.env.example
